{
  "folders": [
    { "name": "Workspace", "path": "." },
    { "name": "Dataset", "path": "dataset" },
    { "name": "Ultralytics", "path": "ultralytics" },
    { "name": "YOLOX", "path": "yolox" },
    { "name": "RF-DETR", "path": "rfdetr" },
    { "name": "Evaluation", "path": "evaluation" },
    { "name": "Detection Common", "path": "detection_common" },
    { "name": "Notebook Tools", "path": "notebook-tools" },
    { "name": "Docker", "path": "docker" },
    { "name": "Documents", "path": "documents" }
  ],
  "settings": {
    "python.useEnvironmentsExtension": true,
    "python-envs.workspaceSearchPaths": [".conda/envs"],
    "jupyter.kernels.excludePythonEnvironments": [
      "~/.conda/envs/dataset-dev",
      "~/.conda/envs/evaluation-dev",
      "~/.conda/envs/rfdetr-dev",
      "~/.conda/envs/ultralytics-dev",
      "~/.conda/envs/yolox-dev"
    ],
    "files.exclude": {
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/.ruff_cache": true,
      "**/*.egg-info": true
    },
    "git.openRepositoryInParentFolders": "always",
    "makefile.configureOnOpen": false,
    "jupytextSync.syncDocuments": {
      "onNotebookDocumentSave": true,
      "onTextDocumentSave": true
    },
    "[markdown]": {
      "rewrap.wrappingColumn": 88,
      "editor.rulers": [88]
    },
    "[python]": {
      "rewrap.wrappingColumn": 88,
      "editor.rulers": [88]
    },
    "[sh]": {
      "rewrap.wrappingColumn": 80,
      "editor.rulers": [80]
    },
    "editor.minimap.enabled": false
  },
  "extensions": {
    "recommendations": ["caenrigen.jupytext-sync"]
  }
}
